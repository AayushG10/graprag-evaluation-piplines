# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "gemini" (recommended) or "openrouter"
LLM_PROVIDER=gemini

# ── Gemini (Google) ───────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_JUDGE_MODEL=gemini-2.0-flash

# ── OpenRouter (fallback) ─────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
JUDGE_MODEL=openai/gpt-4o-mini

# ── Embeddings (local, no key needed) ────────────────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIMENSION=384

# ── FAISS ─────────────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/processed/faiss.index
CHUNKS_PATH=data/processed/chunks.jsonl
TOP_K=5

# ── TigerGraph Savanna ────────────────────────────────────────────────────────
# 1. Create a free workspace at https://tgcloud.io
# 2. Copy the hostname from workspace details (no https://)
# 3. Go to Admin Panel → User Management → Secrets → Add Secret
TIGERGRAPH_HOST=your-workspace-id.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=FinanceGraph
TIGERGRAPH_SECRET=your_secret_here

# Optional: pre-fetched JWT token (skips secret-based token exchange)
# Run: python3 -c "import requests; r=requests.post('https://HOST/gsql/v1/tokens', json={'secret':'SECRET'}); print(r.json()['token'])"
TIGERGRAPH_TOKEN=

# ── SEC ingestion ─────────────────────────────────────────────────────────────
SEC_DATA_DIR=data/raw
PROCESSED_DIR=data/processed
FILING_YEARS=2019,2020,2021,2022,2023
CHUNK_SIZE=512
CHUNK_OVERLAP=64
